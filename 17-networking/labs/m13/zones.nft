flush ruleset
table inet zfw {
  set admin_src {
    type ipv4_addr
    elements = { 10.13.1.99 }
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "fw-ext" oifname "fw-dmz" tcp dport 443 accept comment "Internet -> ingress"
    iifname "fw-dmz" oifname "fw-app" tcp dport 8443 accept comment "ingress -> auth"
    iifname "fw-ext" oifname "fw-app" ip saddr @admin_src tcp dport 22 accept comment "bastion -> SSH"
    iifname "fw-app" oifname "fw-ext" ip daddr 10.13.1.10 tcp dport 443 accept comment "egress: chi toi IdP"
    limit rate 5/second log prefix "zfw-drop: " level info
    counter comment "bi drop boi policy"
  }
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    iif "lo" accept
    icmp type echo-request limit rate 5/second accept
  }
}
