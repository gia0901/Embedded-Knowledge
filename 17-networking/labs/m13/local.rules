alert http any any -> any any (msg:"NETLAB admin path accessed"; flow:to_server,established; http.uri; content:"/admin"; startswith; sid:1000001; rev:1;)
alert http any any -> any any (msg:"NETLAB curl user-agent"; flow:to_server,established; http.user_agent; content:"curl/"; startswith; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"NETLAB possible SYN scan"; flags:S,12; threshold: type both, track by_src, count 50, seconds 5; sid:1000003; rev:1;)
alert tls any any -> any any (msg:"NETLAB TLS to internal auth service"; tls.sni; content:"auth.security.svc.cluster.local"; sid:1000004; rev:1;)
